---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, AUTHORS, EDITORIAL_PRINCIPLES, ADSENSE, CATEGORIES, ABOUT } from "../site.config";
import { categoryUrl } from "../lib/utils";

const author = Object.values(AUTHORS)[0];
const posts = (await getCollection("posts")).filter((p) => !p.data.draft);
const countBy = (slug: string) => posts.filter((p) => p.data.category === slug).length;
const lastDate = posts
  .map((p) => (p.data.updatedDate ?? p.data.publishDate).getTime())
  .reduce((a, b) => Math.max(a, b), 0);
const fmt = (t: number) =>
  new Date(t).toLocaleDateString("ko-KR", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title="소개" description={`${SITE.name}는 어떤 곳이고 누가, 어떤 기준으로 쓰는지 소개합니다.`}>
  <article class="container prose">
    <h1>소개</h1>
    <p class="lead">{SITE.tagline}</p>

    <h2>어떤 곳인가요</h2>
    {ABOUT.what.map((t) => <p>{t}</p>)}

    <h2>이런 걸 다뤄요</h2>
    <ul>
      {CATEGORIES.map((c) => (
        <li>
          <a href={categoryUrl(c.slug)}><strong>{c.emoji} {c.name}</strong></a> — {c.description}{" "}
          <span class="muted small">(글 {countBy(c.slug)}편)</span>
        </li>
      ))}
    </ul>

    <h2>누가 쓰나요</h2>
    <p><strong>{author.name}</strong> — {author.intro}</p>

    <h2>글은 이렇게 만들어요</h2>
    <ol>
      {ABOUT.process.map((t) => <li>{t}</li>)}
    </ol>

    <h2>편집 원칙</h2>
    <ul>
      {EDITORIAL_PRINCIPLES.map((p) => (
        <li><strong>{p.title}.</strong> {p.body}</li>
      ))}
    </ul>

    <h2>이건 다루지 않아요</h2>
    <ul>
      {ABOUT.limits.map((t) => <li>{t}</li>)}
    </ul>

    <h2>수익은 이렇게 나요</h2>
    <p>
      이 사이트는 {ADSENSE.clientId ? "Google 애드센스 광고" : "광고"}로 운영비를 마련해요.{" "}
      <strong>광고와 글의 내용은 서로 무관해요.</strong> 특정 상품·업체를 좋게 써 주는 대가를 받지 않고,
      제휴·협찬 관계도 없어요. 광고는 본문과 구분되는 자리에 표시돼요.
    </p>

    <h2>운영 정보</h2>
    <ul>
      <li>사이트 이름: {SITE.name}</li>
      <li>운영 시작: {ABOUT.since}</li>
      <li>발행한 글: {posts.length}편</li>
      {lastDate > 0 && <li>최근 업데이트: {fmt(lastDate)}</li>}
      <li>문의: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
    </ul>

    <h2>오류를 발견하면</h2>
    <p>
      틀린 내용이나 바뀐 정보를 발견하면 <a href={`mailto:${SITE.email}`}>{SITE.email}</a> 로 알려주세요.
      확인해서 고치고, 글에 수정일을 남길게요. 자세한 방법은 <a href="/contact/">문의 페이지</a>에 있어요.
    </p>
  </article>
</BaseLayout>
